# =============================================================
# Docker 构建上下文排除项（减小镜像体积、避免把密钥打进镜像）
# =============================================================
.git
.gitignore
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# 文档与截图（镜像内不需要）
docs/
*.md

# 归档的静态快照页（未被代码引用）
static_dk_home.html
static_dk_insight.html

# 密钥 / 环境变量
.secret_key
.env

# Docker 自身文件
Dockerfile
docker-compose.yml
.dockerignore
