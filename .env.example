# =============================================================
# 每日热点 —— Docker 部署环境变量示例
# 用法：复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）
#   cp .env.example .env
# 未设置的项均有安全默认值，最小配置下可直接 docker compose up -d
# =============================================================

# ---------------- 数据库 ----------------
MYSQL_ROOT_PASSWORD=123456
DB_NAME=daily_hot

# ---------------- Web ----------------
# 对外访问端口（宿主机端口:容器端口 的左侧）
# 若本机已用 `python app.py` 跑着站点（默认就占 5000），这里要改，例如：
#   WEB_PORT=5001
# 否则 docker 启动会报端口被占用
WEB_PORT=5000
# 对外地址，用于 RSS 链接与推送消息里的「查看完整洞察」
# 局域网/IPv6 示例：http://[2408:8256:3884:2871::1]:5000
SITE_URL=http://localhost:5000
# 建议设置，避免容器重建后登录态失效
SECRET_KEY=

# ---------------- 定时抓取（东八区）----------------
CRAWL_HOUR=8
CRAWL_MINUTE=0

# ---------------- 生产模式 ----------------
# flask（默认，内置服务器，定时任务随主进程） / gunicorn（推荐生产）
SERVER=flask

# ---------------- 构建加速（国内可选）----------------
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---------------- 可选：AI 综述 ----------------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------- 可选：Telegram 推送 ----------------
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---------------- 可选：邮件推送 ----------------
# QQ 邮箱：SMTP_HOST=smtp.qq.com，SMTP_PORT=465，密码填「授权码」不是登录密码
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
